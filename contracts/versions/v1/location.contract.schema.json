{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "location.contract.schema.json",
  "title": "Absolute location contract (HYPOINVERSE)",
  "description": "绝对定位环节的产出契约：定位目录、原生输出保留、模型一致性与定位质量。",
  "allOf": [{"$ref": "common.schema.json"}],
  "type": "object",
  "required": [
    "model_file",
    "station_file",
    "phase_file",
    "outputs",
    "stats"
  ],
  "properties": {
    "stage": {"const": "location"},
    "model_file": {
      "type": "object",
      "required": ["path", "same_as_association"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string"},
        "same_as_association": {
          "type": "boolean",
          "description": "与关联环节速度模型是否一致；false 必须在 warnings 中说明理由"
        }
      },
      "additionalProperties": false
    },
    "station_file": {
      "type": "object",
      "required": ["path", "generated_from"],
      "properties": {
        "path": {"type": "string"},
        "generated_from": {"type": "string", "description": "台站文件来源契约指针"}
      },
      "additionalProperties": false
    },
    "phase_file": {
      "type": "object",
      "required": ["path", "generator"],
      "properties": {
        "path": {"type": "string"},
        "generator": {"type": "string", "description": "如 assignments→hypoinverse pha"}
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "properties": {
        "depth_init_km": {"type": "number"},
        "fix_depth_rule": {"type": "string"},
        "distance_weighting": {"type": "string"}
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": ["catalog_path", "arc_path", "located_schema"],
      "properties": {
        "catalog_path": {"type": "string"},
        "arc_path": {
          "type": "string",
          "description": "原生 .arc 保留，供 SKHASH 取极性与震源-台站几何"
        },
        "located_schema": {
          "type": "array",
          "items": {"type": "string"},
          "description": "至少含 event_id/origin_utc/lat/lon/depth_km/nph/gap_deg/rms_s/erh_km/erz_km"
        }
      },
      "additionalProperties": true
    },
    "stats": {
      "type": "object",
      "required": ["events_in", "located", "rejected", "reject_reasons"],
      "properties": {
        "events_in": {"type": "integer"},
        "located": {"type": "integer"},
        "rejected": {"type": "integer"},
        "reject_reasons": {
          "type": "object",
          "description": "失败原因计数；不可用的原因是数据不是备注"
        }
      },
      "additionalProperties": true
    },
    "qc": {
      "type": "object",
      "properties": {
        "rms_median_s": {"type": "number"},
        "gap_p90_deg": {"type": "number"},
        "depth_histogram": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
