{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detection.contract.schema.json",
  "title": "Matched-filter detection contract (MESS)",
  "description": "模板匹配检测环节的产出契约：模板来源与处理兼容性、扫描与去重规则、检测结果。",
  "allOf": [{"$ref": "common.schema.json"}],
  "type": "object",
  "required": [
    "template_source",
    "template_processing",
    "scan",
    "dedup",
    "outputs",
    "stats"
  ],
  "properties": {
    "stage": {"const": "detection"},
    "template_source": {
      "type": "object",
      "required": ["catalog", "event_selection_rule"],
      "properties": {
        "catalog": {"type": "string", "description": "模板事件来源契约，如 relocation_contract"},
        "event_selection_rule": {"type": "string", "description": "如 quality>=B；依据须可查"}
      },
      "additionalProperties": false
    },
    "template_processing": {
      "type": "object",
      "required": ["compatible_with_preprocess_contract"],
      "properties": {
        "compatible_with_preprocess_contract": {
          "type": "boolean",
          "description": "模板与扫描数据是否采用与归档兼容的处理设置"
        },
        "derived_copy_path": {
          "type": ["string", "null"],
          "description": "不兼容时生成单独派生副本的路径；绝不修改原归档"
        },
        "band_hz": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "sampling_rate_hz": {"type": "number"}
      },
      "additionalProperties": true
    },
    "scan": {
      "type": "object",
      "properties": {
        "window_s": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "threshold_mad": {"type": "number"},
        "min_stations": {"type": "integer"},
        "channel_rule": {"type": "string", "description": "如 Z_only_or_3c"}
      },
      "additionalProperties": true
    },
    "dedup": {
      "type": "object",
      "required": ["rule", "against_known_catalog"],
      "properties": {
        "rule": {"type": "string", "description": "如 same_event_within_2s_keep_max_cc"},
        "against_known_catalog": {
          "type": "boolean",
          "description": "是否对已有目录去重，区分新检测与已知事件"
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": ["detections_path", "new_events_path", "schema"],
      "properties": {
        "detections_path": {"type": "string"},
        "new_events_path": {"type": "string"},
        "schema": {
          "type": "array",
          "items": {"type": "string"},
          "description": "至少含 detect_id/template_event/time_utc/mean_cc/n_stations"
        }
      },
      "additionalProperties": true
    },
    "stats": {
      "type": "object",
      "properties": {
        "templates": {"type": "integer"},
        "detections_raw": {"type": "integer"},
        "after_dedup": {"type": "integer"},
        "new_events": {"type": "integer"}
      },
      "additionalProperties": true
    }
  }
}
